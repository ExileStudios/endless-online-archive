    <MAINSOURCE value="EndlessUnits.bpf"/>
    <PATHCPP value=".;"/>
    <USERDEFINES value="NO_STRICT"/>
    <SYSDEFINES value=""/>
    <INCLUDEPATH value="$(BCB)\include;$(BCB)\include\vcl;..\lib\tdx\inc0;..\lib\tdx\inc1;..\lib\tdx\inc2;..\lib\tdx\inc3;..\lib\tdx\inc4;..\lib\tdx\inc5;..\lib\tdx\inc6;..\lib\tdx\inc7;..\lib\tdx\inc8"/>
    <LIBPATH value="$(BCB)\lib\obj;$(BCB)\lib;$(BCB)\lib\release;..\lib\dx"/>
    <WARNINGS value="-w-8057"/>
    <PATHASM value=".;"/>
    <PATHPAS value=".;"/>
    <PATHRC value=".;"/>
    <DEBUGLIBPATH value="$(BCB)\lib\debug"/>
    <RELEASELIBPATH value="$(BCB)\lib\release"/>
    <LINKER value="TLib"/>
  </MACROS>
  <OPTIONS>
    <CFLAG1 value="-O2 -vi -tWM -c"/>
    <PFLAGS value="-v -$Y -$W -$O- -JPHNE -M"/>
    <LFLAGS value=""/>
  </OPTIONS>
  <LINKER>
    <ALLOBJ value="$(OBJFILES)"/>
  </LINKER>
  <IDEOPTIONS>

